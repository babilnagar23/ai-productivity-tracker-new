# ============================================================
# AI Productivity Tracker — Environment Configuration
# ============================================================
# Copy this file to server/.env and fill in your values.
# Never commit server/.env to version control.
# ============================================================

# ── Django Core ─────────────────────────────────────────────
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-long-random-secret-key-here

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (production / Supabase)
# Format: postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/productivity_tracker

# SQLite alternative for local development (leave DATABASE_URL unset to use this):
# DATABASE_URL=sqlite:///db.sqlite3

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave empty in development — console backend will be used automatically
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@productivitytracker.app

# ── Groq AI ──────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Google Calendar OAuth ────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/callback

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Application ──────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata
APP_VERSION=1.0.0

# ── Production Security (set when DEBUG=False) ───────────────
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=False  # Set True only if not behind a load balancer
