# ROOT ENVIRONMENT CONFIGURATION
# Copy these values into a file named .env in the root directory or inside server/

PORT=8000
DJANGO_SECRET_KEY=your_django_secret_key
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Groq AI — get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional PostgreSQL. Leave empty to use SQLite in development.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Google Calendar integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/callback
